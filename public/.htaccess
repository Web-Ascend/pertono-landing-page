# Ersetzt die alte Hoster-.htaccess auf dem Webspace, die / auf die
# inzwischen gelöschte /de/-Site umleitete. Der Mirror im Deploy schließt
# Dotfiles bewusst aus (Schutz für server-seitige Dateien wie .well-known),
# deshalb wird diese Datei im Anschluss separat per put hochgeladen — sonst
# würde die alte Weiterleitung jeden Deploy überleben.

AddDefaultCharset UTF-8

# ── Seiten als index.php ───────────────────────────────────────────────────
# Der Build verpackt jede index.html in eine index.php (scripts/wrap-php.mjs):
# nginx beim Hoster liefert vorhandene .html am Apache vorbei aus, und dann
# fehlen die Security-Header unten. Eine .php-Datei geht immer durch Apache.
# Die URLs bleiben gleich.
DirectoryIndex index.php index.html

# Die Sprachpfade der Vorgänger-Site führen ins Leere — alte Links und
# gecachte 301s landen auf der Startseite statt auf einem 404.
RedirectMatch 301 ^/(de|en)(/.*)?$ /

# ── App-Deeplinks ──────────────────────────────────────────────────────────
# Einladungslinks (pertono.com/einladung/<Code>) gehören der App, nicht dieser
# Seite. Ist die App installiert und die Domain verifiziert (assetlinks.json /
# apple-app-site-association in /.well-known/), fängt das Betriebssystem den
# Link ab, bevor er den Server erreicht — diese Regel greift also nur ohne App:
# dann in die Web-App weiterleiten, den Code als Query-Parameter. Query, kein
# #-Fragment: ein Fragment überlebt einen Redirect nicht zuverlässig, ein
# Query-Parameter schon. 302, nicht 301: ob das Ziel App oder Browser ist, hängt
# vom Gerät ab und darf nicht dauerhaft gecacht werden. NE hält die Bindestriche
# im Code unverändert.
RewriteEngine On

# ── HTTP → HTTPS, www → Apex (Audit 2026-10, LP2-3) ─────────────────────────
# Ohne diese Regel lieferte http://pertono.com/ die komplette Seite im
# Klartext aus; HSTS greift erst nach dem ersten HTTPS-Kontakt, und
# `upgrade-insecure-requests` wirkt nur auf Unterressourcen, nicht auf die
# Navigation. Geprüft wird ausschließlich %{HTTPS}, also die Verbindung, die
# Apache selbst sieht — bewusst NICHT X-Forwarded-Proto: diesen Header kann
# jeder Client (und damit jeder Angreifer in der Mitte) selbst setzen und so
# die Umleitung für sein Opfer abschalten. Steht zwischen nginx und Apache
# irgendwann ein reiner HTTP-Proxy, würde diese Regel in eine Schleife laufen;
# der Deploy prüft deshalb nach dem Upload, dass https://pertono.com/ mit 200
# und http://pertono.com/ mit 301 antwortet.
# Die www-Variante antwortet mit identischem Inhalt unter zwei Hostnamen; der
# Canonical-Tag zeigt auf den Apex, die Umleitung macht das verbindlich.
# Vor der Einladungs-Regel, damit auch ein http://…/einladung/<Code> erst auf
# HTTPS und dann (302) in die App geht. Bewusst ohne NE: %{REQUEST_URI} ist in
# mod_rewrite der bereits dekodierte Pfad, erst das Kodieren beim Ausgeben
# macht aus „a b" wieder „a%20b"; der Query-String wird unverändert angehängt.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.pertono\.com$ [NC]
RewriteRule ^ https://pertono.com%{REQUEST_URI} [R=301,L]

RewriteRule ^einladung/([A-Za-z0-9-]+)/?$ https://app.pertono.com/?invite=$1 [R=302,L,NE]

# ── Security-Header (Review 2026-09, W-1) ────────────────────────────────────
# Die Seite hat kein Client-JavaScript, keine Formulare, keine Cookies und
# keine fremden Origins — der Build (dist/) enthält genau ein <script>, und das
# ist der JSON-LD-Datenblock, den kein Browser ausführt. Die CSP kann deshalb
# streng sein: nichts außer der eigenen Origin, gar kein Skript, keine
# Einbettung in fremde Seiten. 'unsafe-inline' bei style-src braucht Astro, das
# die seitenbezogenen <style>-Blöcke in den Kopf schreibt.
#
# Die Vorgängerlösung (`_headers`, SECURITY_REVIEW.md F-12) war eine
# Netlify-Konvention und hat auf diesem Apache nie gegriffen. mod_headers
# dagegen läuft hier nachweislich — der Referrer-Header unten geht seit
# Monaten darüber raus.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Ein Jahr, mit Subdomains — app.pertono.com spricht ohnehin nur HTTPS. Kein
  # `preload`: das ist ein Browser-Eintrag, den man nicht zurücknimmt.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
</IfModule>

# Der Code steht in der URL; er soll nicht zusätzlich über den Referer-Header
# irgendwohin mitwandern. Nach dem allgemeinen Header oben, damit dieses `set`
# ihn für die Einladungs-URLs ersetzt statt umgekehrt.
<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/einladung/" pertono_invite=1
  Header always set Referrer-Policy "no-referrer" env=pertono_invite
</IfModule>

# Die apple-app-site-association hat keine Dateiendung und muss trotzdem als
# application/json ausgeliefert werden, sonst ignoriert iOS sie. assetlinks.json
# trägt ihre Endung selbst und braucht das nicht.
<Files "apple-app-site-association">
  ForceType application/json
</Files>

# Fonts und gehashte Assets ändern sich unter derselben URL nie.
<IfModule mod_expires.c>
  ExpiresActive on
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 week"
</IfModule>

# Astro baut die 404-Seite als /404.html; ohne diese Zeile liefert Apache
# seine eigene, nackte Fehlerseite aus.
ErrorDocument 404 /404.html
