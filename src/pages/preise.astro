---
import BaseLayout from "../layouts/BaseLayout.astro";

/**
 * Prices are placeholders until the plans are decided. They are written as
 * data rather than markup so replacing them is a one-line change, and the page
 * says plainly that they are not final — a Verein budgets a year ahead and
 * will hold us to whatever is printed here.
 *
 * Two decisions are encoded in this shape:
 *
 * `perMonth` is what a Verein compares against other tools, `perYear` is what
 * it actually pays — one invoice, because that is how a Kassenwart budgets and
 * because a fixed transaction fee eats a noticeable share of a 12 € debit and
 * almost nothing of a 144 € one. Both are printed so neither is a surprise.
 *
 * The free plan is bounded by member count *and* by feature: collecting dues
 * is what the paid plans are for. That is deliberate — the Verein that wants
 * a Beitragslauf converts on the feature, long before it grows past 50
 * members — and the FAQ below says so rather than letting somebody find out
 * after importing their members.
 */
const plans = [
  {
    name: "Kostenlos",
    perMonth: 0,
    perYear: 0,
    limit: "bis 50 Mitglieder",
    features: [
      "Mitgliederverwaltung",
      "Termine und Zusagen",
      "Ankündigungen per Push",
      "Kassenbuch mit Belegfotos",
    ],
    highlighted: false,
  },
  {
    name: "Verein",
    perMonth: 12,
    perYear: 144,
    limit: "bis 300 Mitglieder",
    features: [
      "Alles aus Kostenlos",
      "Beitragsläufe und Beitragsordnung",
      "SEPA-Lastschrift als XML-Datei",
      "Kassenbericht für die Jahreshauptversammlung",
      "Abteilungen und Abteilungsleitung",
    ],
    highlighted: true,
  },
  {
    name: "Groß",
    perMonth: 19,
    perYear: 228,
    limit: "bis 800 Mitglieder",
    features: ["Alles aus Verein", "Automatischer Kontoabgleich", "Mahnläufe"],
    highlighted: false,
  },
  {
    name: "Unbegrenzt",
    perMonth: 29,
    perYear: 348,
    limit: "ohne Mitgliederlimit",
    features: ["Alles aus Groß", "Datenexport für den Steuerberater"],
    highlighted: false,
  },
];
---

<BaseLayout
  title="Preise"
  description="Pertono kostet kleine Vereine nichts und alle anderen weniger als ein Mitgliedsbeitrag. Ein Preis pro Verein, eine Rechnung im Jahr, jederzeit kündbar."
>
  <h1>Preise</h1>
  <p class="lead">
    Ein Preis pro Verein, nicht pro Vorstandsmitglied. Alle Preise inklusive
    Umsatzsteuer, abgerechnet einmal im Jahr per Rechnung, jederzeit kündbar.
    Wer unter 50 Mitglieder hat und keine Beiträge einzieht, zahlt nichts.
  </p>

  <p class="notice" role="note">
    <strong>Noch nicht final:</strong> Pertono ist in Entwicklung. Die Tarife hier
    zeigen die geplante Struktur, die Beträge können sich bis zum Start noch
    ändern.
  </p>

  <ul class="plans">
    {
      plans.map((plan) => (
        <li class:list={["plan", plan.highlighted && "plan--highlighted"]}>
          <h2>{plan.name}</h2>
          <p class="price">
            <strong>{plan.perMonth} €</strong>
            <span>{plan.perMonth === 0 ? "dauerhaft" : "pro Monat"}</span>
          </p>
          <p class="billing">
            {plan.perMonth === 0
              ? "keine Rechnung, keine Zahlungsdaten"
              : `${plan.perYear} € im Jahr, eine Rechnung`}
          </p>
          <p class="limit">{plan.limit}</p>
          <ul class="features">
            {plan.features.map((feature) => (
              <li>{feature}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>

  <section aria-labelledby="faq">
    <h2 id="faq">Häufige Fragen</h2>

    <h3>Zahlt der Verein oder jedes Vorstandsmitglied?</h3>
    <p>
      Der Verein. Wie viele Personen im Vorstand mitarbeiten, spielt für den
      Preis keine Rolle.
    </p>

    <h3>Wie wird abgerechnet?</h3>
    <p>
      Einmal im Jahr, per Rechnung auf den Verein. Das passt zu einem Haushalt,
      der auf der Jahreshauptversammlung beschlossen wird: eine Position, ein
      Beleg für die Kassenprüfung, keine zwölf Kleinbeträge im Kassenbuch. Wer
      lieber monatlich zahlt, kann das per SEPA-Lastschrift tun — zum selben
      Monatspreis.
    </p>

    <h3>Wir haben nur 30 Mitglieder und wollen Beiträge einziehen — reicht der kostenlose Tarif?</h3>
    <p>
      Nein. Der kostenlose Tarif ist für Mitgliederverwaltung, Termine und
      Kassenbuch vollständig — Beitragsläufe und SEPA-Lastschrift gehören zum
      Tarif „Verein“, unabhängig von der Mitgliederzahl. Wer Beiträge über
      Pertono einzieht, ist im Tarif „Verein“, auch mit 30 Mitgliedern. Wer
      seine Beiträge weiter selbst überweisen lässt, bleibt kostenlos.
    </p>

    <h3>Was passiert, wenn wir über das Mitgliederlimit wachsen?</h3>
    <p>
      Bestehende Daten bleiben vollständig erhalten und lesbar. Neue Mitglieder
      lassen sich erst nach einem Tarifwechsel anlegen.
    </p>

    <h3>Nehmt ihr eine Gebühr auf eingezogene Beiträge?</h3>
    <p>
      Nein. Pertono erzeugt die SEPA-Datei, den Einzug macht deine Vereinsbank.
      Das Geld fließt zwischen eurem Konto und euren Mitgliedern, es läuft nie
      über uns.
    </p>

    <h3>Kommen wir wieder raus?</h3>
    <p>
      Jederzeit. Eine bezahlte Jahresrechnung erstatten wir anteilig für die
      Monate, die ihr nicht mehr nutzt. Mitglieder, Buchungen und Belege lassen
      sich als offene Datei exportieren, auch im kostenlosen Tarif.
    </p>
  </section>
</BaseLayout>

<style>
  .lead {
    font-size: 1.15rem;
    color: var(--muted);
    max-width: 42rem;
  }

  .notice {
    border: 1px solid var(--line);
    border-left: 4px solid var(--brand);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    background: var(--surface-alt);
    max-width: 42rem;
  }

  .plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin-block: 2.5rem;
  }

  .plan {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .plan--highlighted {
    border-color: var(--brand);
    border-width: 2px;
    background: var(--surface-alt);
  }

  .plan h2 {
    margin-top: 0;
    font-size: 1.25rem;
  }

  .price {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-block: 0.5rem 0.25rem;
  }

  .price strong {
    font-size: 2rem;
    letter-spacing: -0.02em;
  }

  /* Was tatsächlich abgerechnet wird, direkt unter dem Vergleichspreis —
     nicht im Kleingedruckten, weil genau das die Überraschung wäre. */
  .billing {
    margin-block: 0 0.5rem;
    font-size: 0.9375rem;
    color: var(--brand);
  }

  .price span,
  .limit {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .features {
    margin-top: 1.25rem;
    padding-left: 1.1rem;
  }

  .features li {
    margin-block: 0.4rem;
  }

  h3 {
    margin-top: 1.75rem;
  }
</style>
