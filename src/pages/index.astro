---
import BaseLayout from "../layouts/BaseLayout.astro";
import PertonoLogo from "../components/PertonoLogo.astro";
import { hasOpenTodos, noindex as isDraft } from "../data/legal";
import { platforms, statusLabel } from "../data/platforms";

/**
 * Die Startseite: Produkt-Pitch, Funktionen, die unterstützten Plattformen
 * und der Weg zu Preisen, Ratgeber und Rechtsseiten. Zusammengeführt aus der
 * Marketing-Startseite des pertono-Repos und der bisherigen Landing Page
 * (Plattform-Karten, Entwurfs-Hinweis).
 *
 * Das noindex während der Entwurfsphase setzt das BaseLayout zentral über
 * das Gate aus src/data/legal.ts — hier steuert es nur noch den sichtbaren
 * Hinweis-Kasten.
 */

const claims = [
  {
    title: "Beitragslauf in unter zwei Minuten",
    body: "Zeitraum wählen, Vorschau prüfen, SEPA-Datei herunterladen. Die Datei lädst du in dein gewohntes Online-Banking — dein Vereinskonto bleibt dein Vereinskonto.",
  },
  {
    title: "Kassenbuch mit Belegfoto",
    body: "Beleg abfotografieren, Betrag und Kategorie eintragen, fertig. Der Kassenbericht für die Jahreshauptversammlung entsteht nebenbei.",
  },
  {
    title: "Mitglieder ohne Tabellen-Chaos",
    body: "Ein- und Austritte, Abteilungen, Ermäßigungen. Was der Vorstand sieht und was der Kassenwart sieht, ist sauber getrennt.",
  },
  {
    title: "Termine und Ankündigungen",
    body: "Einladen, Zu- und Absagen sammeln, per Push erinnern. Ohne dass jemand eine weitere Gruppe beitreten muss.",
  },
];

/** JSON-LD, damit das Produkt als Produkt erscheint, nicht als Textseite.
    operatingSystem nennt nur, was es gibt — iOS kommt dazu, wenn es live ist. */
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Pertono",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Android, Web",
  inLanguage: "de",
  description:
    "Vereinsverwaltung fürs Handy: Mitglieder, Beiträge, SEPA-Lastschrift, Kassenbuch und Termine für ehrenamtliche Vorstände.",
};
---

<BaseLayout
  title="Pertono — Vereinsverwaltung, die aufs Handy passt"
  noSuffix
  description="Mitglieder, Beiträge, SEPA-Lastschrift und Kassenbuch für deinen Verein. Jede Kernaufgabe in unter zwei Minuten am Handy, ohne Einarbeitung. Server in der EU."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(structuredData)}
    slot="head"
  />

  <section class="hero">
    <PertonoLogo d={40} withSubline />
    <h1>Vereinsverwaltung, die aufs Handy passt</h1>
    <p class="lead">
      Die meisten Vereinsprogramme sind für Büroarbeit gebaut. Vereinsarbeit
      passiert aber abends auf dem Sofa, zwischen Training und Abendessen.
      Pertono ist dafür gemacht: jede Kernaufgabe in unter zwei Minuten, ohne
      Handbuch.
    </p>
    <p class="cta-row">
      <a class="button" href="/preise/">Preise ansehen</a>
      <a class="button button--ghost" href="/blog/">Ratgeber lesen</a>
    </p>
  </section>

  <section aria-labelledby="funktionen">
    <h2 id="funktionen">Was Pertono kann</h2>
    <ul class="cards">
      {
        claims.map((claim) => (
          <li class="card">
            <h3>{claim.title}</h3>
            <p>{claim.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="plattformen">
    <h2 id="plattformen">Pertono nutzen</h2>
    <ul class="platforms">
      {
        platforms.map((platform) => (
          <li class="platform">
            <h3>{platform.name}</h3>
            <p class="platform-desc">{platform.description}</p>
            {platform.status === "live" && platform.href ? (
              <a class="platform-link" href={platform.href}>
                {platform.linkLabel ?? "Öffnen"}
              </a>
            ) : (
              <p class="platform-status">
                {statusLabel[platform.status as "soon" | "planned"]}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="datenschutz" class="panel">
    <h2 id="datenschutz">Wo eure Daten liegen</h2>
    <p>
      Mitgliederdaten sind personenbezogene Daten, und ein Verein haftet dafür.
      Pertono speichert sie auf Servern in der Europäischen Union. Wer im Verein
      was sehen darf, entscheidet nicht die App, sondern die Datenbank — ein
      Mitglied sieht seinen eigenen Datensatz, der Vorstand die Mitgliederliste,
      der Kassenwart die Finanzen.
    </p>
  </section>

  {
    isDraft && (
      <p class="notice" role="note">
        <strong>Entwurf.</strong>{" "}
        {hasOpenTodos ? (
          <>Die Anbieterangaben auf den Rechtsseiten sind noch nicht vollständig.</>
        ) : (
          <>Die anwaltliche Prüfung der Rechtsseiten steht noch aus.</>
        )}
      </p>
    )
  }
</BaseLayout>

<style>
  .hero {
    max-width: 46rem;
  }

  .hero h1 {
    /* Der 0.5 * D Schutzraum, der der Marke bei d={40} zusteht. */
    margin-top: 1.75rem;
  }

  .lead {
    font-size: 1.2rem;
    color: var(--muted);
  }

  .cta-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 1.25rem;
    list-style: none;
    padding: 0;
  }

  .card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem;
    background: var(--surface-alt);
  }

  .card h3 {
    margin-top: 0;
    font-size: 1.0625rem;
  }

  .card p {
    margin-bottom: 0;
    color: var(--muted);
  }

  .platforms {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1rem;
  }

  .platform {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-alt);
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
  }

  .platform h3 {
    margin: 0;
  }

  .platform-desc {
    margin: 0.35rem 0 0.75rem;
    color: var(--muted);
    flex: 1;
  }

  .platform-link {
    display: inline-block;
    align-self: start;
    background: var(--brand);
    color: var(--on-brand);
    text-decoration: none;
    font-weight: 600;
    padding: 0.6rem 1rem;
    border-radius: var(--radius);
  }

  .platform-link:hover {
    background: var(--brand-dark);
  }

  .platform-status {
    align-self: start;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
    margin: 0;
  }

  .panel {
    margin-top: 3rem;
    padding: 1.75rem;
    border-left: 4px solid var(--brand);
    background: var(--surface-alt);
    border-radius: var(--radius);
    max-width: 46rem;
  }

  .notice {
    margin-top: 3rem;
  }
</style>
