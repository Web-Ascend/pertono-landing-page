---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

// Drafts never reach a build, so an unfinished post cannot be indexed.
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);

const comparisons = (await getCollection("vergleich", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);

const dateFormat = new Intl.DateTimeFormat("de-DE", { dateStyle: "long" });
---

<BaseLayout
  title="Ratgeber"
  description="Praktische Anleitungen zu Vereinsverwaltung, Kassenführung und SEPA-Lastschrift — geschrieben für ehrenamtliche Vorstände, nicht für Buchhalter."
>
  <h1>Ratgeber</h1>
  <p class="lead">
    Was ein Vorstand wissen muss, ohne Jurastudium: Kassenführung,
    Beitragsordnung, SEPA-Lastschrift, Jahreshauptversammlung.
  </p>

  {posts.length === 0 && <p>Die ersten Beiträge erscheinen in Kürze.</p>}

  <ul class="posts">
    {
      posts.map((post) => (
        <li>
          <article>
            <h2>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h2>
            <p class="meta">
              <time datetime={post.data.publishedAt.toISOString()}>
                {dateFormat.format(post.data.publishedAt)}
              </time>
            </p>
            <p>{post.data.description}</p>
          </article>
        </li>
      ))
    }
  </ul>

  {
    comparisons.length > 0 && (
      <section aria-labelledby="vergleiche">
        <h2 id="vergleiche">Vergleiche</h2>
        <ul class="posts">
          {comparisons.map((entry) => (
            <li>
              <article>
                <h3>
                  <a href={`/vergleich/${entry.id}/`}>{entry.data.title}</a>
                </h3>
                <p>{entry.data.description}</p>
              </article>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  .lead {
    color: var(--muted);
    max-width: 42rem;
    font-size: 1.15rem;
  }
  .posts {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 2rem;
    margin-block: 2.5rem;
  }
  .posts h2,
  .posts h3 {
    margin-block: 0 0.25rem;
    font-size: 1.25rem;
  }
  .posts a {
    text-decoration: none;
  }
  .posts a:hover {
    text-decoration: underline;
  }
  .meta {
    color: var(--muted);
    font-size: 0.9375rem;
    margin-block: 0 0.5rem;
  }
</style>
