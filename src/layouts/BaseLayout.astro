---
/**
 * Der Seitenrahmen der Rechts-Site.
 *
 * Abgespeckte Fassung des BaseLayouts aus dem pertono-Repo: gleiche
 * Brand-Farben und -Schriften, aber ohne Marketing-Navigation und mit einer
 * schmalen Lesespalte — die Seiten hier sind lange Fließtexte.
 *
 * `noindex` kommt pro Seite: die Rechtsseiten setzen es DAUERHAFT (sie sollen
 * nie in einem Suchindex landen), die Startseite bindet es an das
 * Entwurfs-Gate aus src/data/legal.ts.
 */
import PertonoLogo from "../components/PertonoLogo.astro";

interface Props {
  title: string;
  description: string;
  /** Rendert den Titel ohne das "— Pertono"-Suffix (für die Startseite). */
  noSuffix?: boolean;
  noindex?: boolean;
}

const { title, description, noSuffix = false, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = noSuffix ? title : `${title} — Pertono`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="Pertono" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#1F3A5F" />

    <!-- Selbst gehostet statt von fonts.gstatic.com geladen: das Produkt
         verspricht, dass Daten in der EU bleiben — dann soll niemand auf dem
         Weg zur Datenschutzerklärung seine IP-Adresse an Google reichen. -->
    <link
      rel="preload"
      href="/fonts/space-grotesk-700-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>

  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>

    <!-- Nur das Wordmark: Datenschutz und Impressum sind Pflichtlinks, keine
         Navigation — sie stehen im Footer (und auf der Startseite als
         eigener Abschnitt), nicht im Header. -->
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="wordmark" aria-label="Pertono, zur Übersicht">
          <PertonoLogo d={24} />
        </a>
      </div>
    </header>

    <main id="inhalt" class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <nav aria-label="Rechtliches (Fußzeile)">
          <ul>
            <li><a href="/impressum/">Impressum</a></li>
            <li><a href="/datenschutz/">Datenschutz</a></li>
          </ul>
        </nav>
        <p class="footer-note">
          Pertono — Vereinsverwaltung fürs Handy. Server in der EU.
        </p>
      </div>
    </footer>

    <style is:global>
      /* Beide Brand-Schriften, latin + latin-ext, aus dem pertono-Repo
         übernommen. `swap`: der Header rendert im Fallback, statt gar nicht,
         während die Datei ankommt. */
      @font-face {
        font-family: "Space Grotesk";
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url("/fonts/space-grotesk-700-latin.woff2") format("woff2");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA,
          U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193,
          U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: "Space Grotesk";
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url("/fonts/space-grotesk-700-latin-ext.woff2") format("woff2");
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF,
          U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020,
          U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
      @font-face {
        font-family: "IBM Plex Mono";
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url("/fonts/ibm-plex-mono-400-latin.woff2") format("woff2");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA,
          U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193,
          U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: "IBM Plex Mono";
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url("/fonts/ibm-plex-mono-400-latin-ext.woff2") format("woff2");
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF,
          U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020,
          U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }

      /* Die vier Brand-Farben aus brand/tokens.json, dann die Rollen, in denen
         die Site sie spielt. Nichts hier erfindet eine Farbe: die Grautöne
         sind Mischungen aus Navy und Paper. Übernommen aus dem pertono-Repo,
         damit beide Sites nachweislich dieselbe Palette tragen. */
      :root {
        --navy: #1f3a5f;
        --accent: #7b98b8;
        --paper: #f4f2ee;
        --deep-ink: #16283f;

        --brand: var(--navy);
        --brand-dark: var(--deep-ink);
        --on-brand: var(--paper);
        --ink: var(--deep-ink);
        --muted: #4f7396;
        --line: color-mix(in srgb, var(--navy) 16%, var(--paper));
        --surface: var(--paper);
        --surface-alt: color-mix(in srgb, var(--navy) 5%, var(--paper));

        /* Konsumiert von components/PertonoLogo.astro. */
        --logo-front: var(--navy);
        --logo-back: var(--accent);
        --logo-word: var(--navy);
        --logo-subline: var(--muted);

        /* Schmaler als auf pertono.com: hier steht nur Fließtext, und eine
           Zeile über die volle Breite eines Monitors liest niemand. */
        --max-width: 46rem;
        --radius: 12px;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --brand: var(--accent);
          --brand-dark: color-mix(in srgb, var(--accent) 78%, var(--paper));
          --on-brand: var(--deep-ink);
          --ink: var(--paper);
          --muted: var(--accent);
          --line: color-mix(in srgb, var(--paper) 18%, var(--deep-ink));
          --surface: var(--deep-ink);
          --surface-alt: color-mix(in srgb, var(--paper) 6%, var(--deep-ink));

          --logo-front: var(--paper);
          --logo-word: var(--paper);
          --logo-subline: var(--accent);
        }
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--surface);
        color: var(--ink);
        font: 400 clamp(1rem, 0.96rem + 0.2vw, 1.0625rem) / 1.65 system-ui, -apple-system,
          "Segoe UI", Roboto, sans-serif;
        -webkit-font-smoothing: antialiased;
        /* Sticky Footer: die Seite füllt mindestens den Viewport, main dehnt
           sich — so klebt der Footer auf kurzen Seiten am unteren Rand statt
           in der Luft zu hängen, und lange Seiten scrollen unverändert. */
        min-height: 100vh;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
      }

      .container {
        width: min(100% - 2.5rem, var(--max-width));
        margin-inline: auto;
      }

      h1,
      h2,
      h3 {
        font-family: "Space Grotesk", system-ui, -apple-system, "Segoe UI", Roboto,
          sans-serif;
        font-weight: 700;
        line-height: 1.2;
        text-wrap: balance;
      }

      h1 {
        font-size: clamp(1.75rem, 1.4rem + 1.6vw, 2.5rem);
        letter-spacing: -0.02em;
      }

      h2 {
        margin-top: 2rem;
        font-size: 1.125rem;
      }

      h3 {
        margin-top: 1.25rem;
        font-size: 1rem;
      }

      a {
        color: var(--brand);
      }

      code {
        font-family: "IBM Plex Mono", ui-monospace, monospace;
        font-size: 0.9em;
        background: var(--surface-alt);
        border: 1px solid var(--line);
        border-radius: 4px;
        padding: 0.1em 0.35em;
      }

      /* Der rote Entwurfs-Kasten, den beide Rechtsseiten zeigen, solange
         Pflichtangaben fehlen. Zentral, damit er überall gleich aussieht. */
      .notice {
        border: 1px solid var(--line);
        border-left: 4px solid #b3261e;
        border-radius: var(--radius);
        padding: 1rem 1.25rem;
        background: var(--surface-alt);
      }

      .updated {
        margin-top: 2.5rem;
        color: var(--muted);
        font-size: 0.9375rem;
      }

      /* Nur bei Tastatur-Fokus sichtbar — genau wer ihn braucht. */
      .skip-link {
        position: absolute;
        left: -9999px;
      }
      .skip-link:focus {
        left: 1rem;
        top: 1rem;
        z-index: 10;
        background: var(--brand);
        color: var(--on-brand);
        padding: 0.75rem 1rem;
        border-radius: var(--radius);
      }

      :focus-visible {
        outline: 3px solid var(--brand);
        outline-offset: 2px;
      }

      .site-header {
        border-bottom: 1px solid var(--line);
        background: var(--surface);
      }

      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-block: 1rem;
        flex-wrap: wrap;
      }

      .wordmark {
        display: inline-flex;
        text-decoration: none;
        padding: 0.5rem;
        margin: -0.5rem;
        border-radius: var(--radius);
      }

      nav ul {
        display: flex;
        gap: 1.25rem;
        list-style: none;
        margin: 0;
        padding: 0;
        flex-wrap: wrap;
      }

      nav a {
        text-decoration: none;
        color: var(--muted);
        padding-block: 0.25rem;
      }

      nav a:hover,
      nav a[aria-current="page"] {
        color: var(--brand);
      }

      main {
        padding-block: clamp(2rem, 1rem + 4vw, 4rem);
        flex: 1;
      }

      .site-footer {
        border-top: 1px solid var(--line);
        background: var(--surface-alt);
        padding-block: 2rem;
        margin-top: 4rem;
        color: var(--muted);
        font-size: 0.9375rem;
      }

      .footer-note {
        margin-block: 0.75rem 0;
      }
    </style>
  </body>
</html>
